  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Unifies similar effects from different mods to prevent duplication and improve compatibility.",
  "authors": [
    "UtherHel"
  ],
  "contact": {
    "homepage": "https://github.com/utherhel/effectification"
  },
  "license": "MIT",
  "icon": "assets/${id}/icon.png",
  "environment": "*",
  "mixins": [
    "effectification.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*",
    "fzzy_config": ">=0.7.0"
  }
}
